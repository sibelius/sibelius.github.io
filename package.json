{
  "name": "gatsby-starter-default",
  "description": "A simple starter to get up and developing quickly with Gatsby",
  "version": "0.1.0",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  },
  "dependencies": {
    "gatsby": "^2.1.31",
    "gatsby-image": "^2.0.33",
    "gatsby-plugin-manifest": "^2.0.24",
    "gatsby-plugin-offline": "^2.0.25",
    "gatsby-plugin-react-helmet": "^3.0.9",
    "gatsby-plugin-sharp": "^2.0.28",
    "gatsby-source-filesystem": "^2.0.24",
    "gatsby-transformer-sharp": "^2.1.17",
    "prop-types": "^15.7.2",
    "react": "^16.8.4",
    "react-dom": "^16.8.4",
    "react-helmet": "^5.2.0",
    "rebass": "^3.0.1",
    "styled-components": "^4.1.3",
    "styled-system": "^4.0.5"
  },
  "devDependencies": {
    "@types/rebass": "^3.0.3",
    "@types/styled-components": "^4.1.12",
    "@types/styled-system": "^3.2.2",
    "gatsby-plugin-react-svg": "^2.1.0",
    "gatsby-plugin-typescript": "^2.0.11",
    "gatsby-transformer-remark": "^2.3.4",
    "gh-pages": "^2.0.1",
    "prettier": "^1.16.4"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write src/**/*.{js,jsx}",
    "serve": "gatsby serve",
    "start": "npm run develop",
    "deploy": "gatsby build && gh-pages -d public -b master",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\""
  }
}
